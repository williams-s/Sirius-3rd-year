    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="total_cards" expression="(row10.yellow_cards == null ? 0 : row10.yellow_cards) +&#xA;(row10.second_yellow_cards == null ? 0 : row10.second_yellow_cards) +&#xA;(row10.direct_red_cards == null ? 0 : row10.direct_red_cards)" type="id_Integer"/>
        <mapperTableEntries name="is_starter" expression="(row10.nb_on_pitch != null &amp;&amp; row10.nb_in_group != null &amp;&amp;&#xD;&#xA;row10.nb_on_pitch.equals(row10.nb_in_group)) ? true : false " type="id_Boolean"/>
        <mapperTableEntries name="goals_per_90" expression="(row10.minutes_played == null || row10.minutes_played == 0.0 || row10.goals == null) ? 0.0 :&#xA;Math.round((row10.goals / row10.minutes_played * 90.0) * 100.0) / 100.0" type="id_Double"/>
        <mapperTableEntries name="assists_per_90" expression="(row10.minutes_played == null || row10.minutes_played == 0.0) ? 0.0 :&#xD;&#xA;Math.round(((row10.assists == null ? 0.0 : (double)row10.assists) / row10.minutes_played * 90.0) * 100.0) / 100.0 " type="id_Double"/>
        <mapperTableEntries name="goal_contributions" expression="(row10.goals == null ? 0.0 : row10.goals) +&#xD;&#xA;(row10.assists == null ? 0.0 : (double)row10.assists) " type="id_Double"/>
        <mapperTableEntries name="goal_contributions_per_90" expression="(row10.minutes_played == null || row10.minutes_played == 0.0) ? 0.0 :&#xA;Math.round((Var.goal_contributions / row10.minutes_played * 90.0) * 100.0) / 100.0" type="id_Double"/>
        <mapperTableEntries name="performance_rating" expression="!Var.has_played ? &quot;N/A&quot; :&#xA;Var.goal_contributions >= 1.0 &amp;&amp; Var.total_cards == 0 ? &quot;Excellent&quot; :&#xA;Var.goal_contributions >= 1.0 &amp;&amp; Var.total_cards > 0 ? &quot;Bon&quot; :&#xA;Var.goal_contributions == 0.0 &amp;&amp; Var.total_cards == 0 ? &quot;Neutre&quot; : &quot;Mauvais&quot;" type="id_String"/>
        <mapperTableEntries name="has_played" expression="(row10.minutes_played != null &amp;&amp; row10.minutes_played > 0.0) ? true : false" type="id_Boolean"/>
        <mapperTableEntries name="discipline_status" expression="Var.total_cards == 0 ? &quot;Propre&quot; :&#xD;&#xA;row10.direct_red_cards != null &amp;&amp; row10.direct_red_cards > 0 ? &quot;Expulsé (rouge direct)&quot; :&#xD;&#xA;row10.second_yellow_cards != null &amp;&amp; row10.second_yellow_cards > 0 ? &quot;Expulsé (2e jaune)&quot; :&#xD;&#xA;&quot;Averti (jaune)&quot; " type="id_String"/>
        <mapperTableEntries name="competition_level" expression="row10.competition_id == null ? &quot;Inconnu&quot; :&#xD;&#xA;row10.competition_id.startsWith(&quot;L1&quot;) ? &quot;Ligue 1&quot; :&#xD;&#xA;row10.competition_id.startsWith(&quot;L2&quot;) ? &quot;Ligue 2&quot; :&#xD;&#xA;row10.competition_id.equalsIgnoreCase(&quot;DFB&quot;) ? &quot;Coupe nationale&quot; :&#xD;&#xA;row10.competition_id.startsWith(&quot;CL&quot;) ? &quot;Champions League&quot; :&#xD;&#xA;row10.competition_id.startsWith(&quot;EL&quot;) ? &quot;Europa League&quot; : &quot;Autre&quot;" type="id_String"/>
      </varTables>
